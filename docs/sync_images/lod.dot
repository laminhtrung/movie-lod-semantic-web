digraph G {graph [bgcolor="white",pad="0.3",dpi=180]; node [shape=box,style="rounded,filled",fillcolor="#EDF4F5",color="#247A86",fontname="Times New Roman",fontsize=16,margin="0.18,0.12"]; edge [color="#247A86",fontname="Times New Roman",fontsize=12];rankdir=LR; a [label="Open license"];b [label="Structured facts"];c [label="Open RDF formats"];d [label="HTTP identifiers"];e [label="External links"];a->b->c->d->e; note [label="Published RDF and local ontology\nCanonical version 3.0.0",fillcolor="#FFF0D8"];d->note [style=dashed];}