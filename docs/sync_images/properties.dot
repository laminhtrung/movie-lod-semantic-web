digraph G {graph [bgcolor="white",pad="0.3",dpi=180]; node [shape=box,style="rounded,filled",fillcolor="#EDF4F5",color="#247A86",fontname="Times New Roman",fontsize=16,margin="0.18,0.12"]; edge [color="#247A86",fontname="Times New Roman",fontsize=12];rankdir=LR; person [label="dbo:Person"];credit [label="ex:Contribution"];film [label="dbo:Film"];role [label="ex:ContributionRole"];person->credit [label="hasContribution"];credit->person [label="contributionBy: functional"];credit->film [label="contributionTo: functional"];credit->role [label="hasRole: functional"];person->film [label="contributedTo: chain",style=dashed];}